}
/* Code Viewer */
.code-box {
    background: #07090e;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 16px;
    font-family: var(--font-code);
    font-size: 0.82rem;
    color: #39adb5;
    height: 460px;
    overflow: auto;
    white-space: pre;
    line-height: 1.5;
}
/* Lua Script Modal */
.script-modal-box {
    max-width: 850px;
    width: 95%;
    max-height: 85vh;
    display: flex;
    flex-direction: column;
}
/* Notification Toast */
.toast-container {
    position: fixed;
    bottom: 24px;
    right: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    z-index: 10000;
}
.toast {
    background: rgba(16, 22, 36, 0.95);
    backdrop-filter: blur(10px);
    border: 1px solid var(--primary);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
    padding: 12px 20px;
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    color: var(--text-main);
    display: flex;
    align-items: center;
    gap: 10px;
    animation: slideIn 0.3s forwards;
}
@keyframes slideIn {
    from { transform: translateX(100%); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
}
/* Utility Badges */
.badge-tag {
    display: inline-block;
    padding: 2px 8px;
    background: rgba(0, 240, 255, 0.1);
    color: var(--primary);
    border-radius: 4px;
    font-size: 0.72rem;
    font-weight: 600;
}
