local function Text(key, subKey)
    local dict = L10N[CurrentLang] or L10N.TH
    if subKey and dict[key] then
        return dict[key][subKey] or subKey
    end
    return dict.Labels[key] or dict.Notifs[key] or dict[key] or key
end

-- Notification System
local function NotifyUser(title, msg, duration)
    duration = duration or 3
    print("[" .. title .. "] " .. msg)
    -- Fire Roblox Notification
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = title,
            Text = msg,
            Duration = duration
        })
    end)
end

