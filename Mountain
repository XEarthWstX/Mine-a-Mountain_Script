-- 4. FUNCTION BUILDERS & LOGIC
-- -------------------------------------------------------------
local function createRow(labelText, actionType, callback)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, 0, 0, 40)
	row.BackgroundColor3 = Color3.fromRGB(28, 31, 39)
	row.Parent = contentFrame
	
	local rowCorner = Instance.new("UICorner")
	rowCorner.CornerRadius = UDim.new(0, 8)
	rowCorner.Parent = row
	
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0.65, -10, 1, 0)
	label.Position = UDim2.new(0, 12, 0, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamMedium
	label.TextSize = 13
	label.TextColor3 = Color3.fromRGB(220, 225, 235)
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Text = labelText
	label.Parent = row
	
	if actionType == "Button" then
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(0.3, 0, 0, 26)
		btn.Position = UDim2.new(0.68, 0, 0.5, -13)
		btn.BackgroundColor3 = Color3.fromRGB(0, 180, 216)
		btn.Font = Enum.Font.GothamBold
		btn.TextSize = 12
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		btn.Text = Locales[currentLang].Execute
		btn.Parent = row
		
		local btnC = Instance.new("UICorner")
		btnC.CornerRadius = UDim.new(0, 6)
		btnC.Parent = btn
		
		btn.MouseButton1Click:Connect(callback)
		
	elseif actionType == "Toggle" then
		local toggled = false
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(0.3, 0, 0, 26)
		btn.Position = UDim2.new(0.68, 0, 0.5, -13)
		btn.BackgroundColor3 = Color3.fromRGB(45, 50, 60)
		btn.Font = Enum.Font.GothamBold
		btn.TextSize = 12
		btn.TextColor3 = Color3.fromRGB(180, 185, 195)
		btn.Text = Locales[currentLang].ToggleOff
		btn.Parent = row
		
		local btnC = Instance.new("UICorner")
		btnC.CornerRadius = UDim.new(0, 6)
		btnC.Parent = btn
		
		btn.MouseButton1Click:Connect(function()
			toggled = not toggled
			if toggled then
				tween(btn, 0.2, {BackgroundColor3 = Color3.fromRGB(0, 201, 167), TextColor3 = Color3.fromRGB(255, 255, 255)})
				btn.Text = Locales[currentLang].ToggleOn
			else
				tween(btn, 0.2, {BackgroundColor3 = Color3.fromRGB(45, 50, 60), TextColor3 = Color3.fromRGB(180, 185, 195)})
				btn.Text = Locales[currentLang].ToggleOff
			end
			callback(toggled)
		end)
		
	elseif actionType == "Input" then
		local box = Instance.new("TextBox")
		box.Size = UDim2.new(0.3, 0, 0, 26)
		box.Position = UDim2.new(0.68, 0, 0.5, -13)
		box.BackgroundColor3 = Color3.fromRGB(38, 42, 52)
		box.Font = Enum.Font.Gotham
		box.TextSize = 12
		box.TextColor3 = Color3.fromRGB(255, 255, 255)
		box.PlaceholderText = "..."
		box.Text = ""
		box.Parent = row
		
		local boxC = Instance.new("UICorner")
		boxC.CornerRadius = UDim.new(0, 6)
		boxC.Parent = box
		
		box.FocusLost:Connect(function(enterPressed)
			if enterPressed then
				local num = tonumber(box.Text)
				if num then
					callback(num)
				end
			end
		end)
	end
end

-- ฟังก์ชันอัปเดตรายการฟังก์ชันเมื่อเปลี่ยนภาษา
local function applyLanguage(langKey)
	currentLang = langKey
	local l = Locales[langKey]
	
	hubTitle.Text = l.HubTitle
	
	-- ล้างรายการเก่า
	for _, child in ipairs(contentFrame:GetChildren()) do
		if not child:IsA("UIListLayout") then
			child:Destroy()
		end
	end
	
	-- 1. WalkSpeed
	createRow(l.WalkSpeedLabel, "Input", function(val)
		if player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
			player.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = val
		end
	end)
	
	-- 2. JumpPower
	createRow(l.JumpPowerLabel, "Input", function(val)
		if player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
			local hum = player.Character:FindFirstChildOfClass("Humanoid")
			hum.UseJumpPower = true
			hum.JumpPower = val
		end
	end)
	
	-- 3. FOV
	createRow(l.FovLabel, "Input", function(val)
		Workspace.CurrentCamera.FieldOfView = math.clamp(val, 30, 120)
	end)
	
	-- 4. Night Vision
	createRow(l.NightVisionLabel, "Toggle", function(state)
		if state then
			Lighting.Ambient = Color3.fromRGB(255, 255, 255)
			Lighting.Brightness = 3
		else
			Lighting.Ambient = Color3.fromRGB(128, 128, 128)
			Lighting.Brightness = 1
		end
	end)
	
	-- 5. Teleport to Spawn
	createRow(l.TpSpawnLabel, "Button", function()
		if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
			local spawnLoc = Workspace:FindFirstChildOfClass("SpawnLocation")
			if spawnLoc then
				player.Character.HumanoidRootPart.CFrame = spawnLoc.CFrame + Vector3.new(0, 5, 0)
			else
				player.Character.HumanoidRootPart.CFrame = CFrame.new(0, 50, 0)
			end
		end
	end)
	
	-- 6. Reset Character
	createRow(l.ResetCharLabel, "Button", function()
		if player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
			player.Character:FindFirstChildOfClass("Humanoid").Health = 0
		end
	end)
end

