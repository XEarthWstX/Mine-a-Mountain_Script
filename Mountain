-- Proximity Prompt Auto-Interactor Daemon (Req 3, 11)
task.spawn(function()
    while true do
        if (States.AutoCrystal or States.AutoRuneFarm or States.AutoCollectOres) and fireproximityprompt then
            pcall(function()
                local myRoot = GetRoot()
                
                -- Auto Crystal / Rune prompt interaction
                local target = States.AutoRuneFarm and States.CurrentRune or States.CurrentCrystal
                if target then
                    local prompt = target:FindFirstChildOfClass("ProximityPrompt") or target:FindFirstChildWhichIsA("ProximityPrompt", true)
                    if prompt then fireproximityprompt(prompt) end
                end

                -- Auto Collect Drops around player (Req 3)
                if States.AutoCollectOres and myRoot then
                    local searchFolders = {DropsFolder, Workspace:FindFirstChild("Drops"), Workspace:FindFirstChild("Items")}
                    for _, folder in ipairs(searchFolders) do
                        if folder then
                            for _, drop in ipairs(folder:GetChildren()) do
                                local part = drop:IsA("BasePart") and drop or drop:FindFirstChildWhichIsA("BasePart", true)
                                if part and (myRoot.Position - part.Position).Magnitude <= States.AutoCollectRadius then
                                    local prompt = drop:FindFirstChildOfClass("ProximityPrompt") or drop:FindFirstChildWhichIsA("ProximityPrompt", true)
                                    if prompt then fireproximityprompt(prompt) end
                                end
                            end
                        end
                    end
                end
            end)
        end
        task.wait(0.1) 
    end
end)

-- BULLETPROOF TRACKING CORE: Crystal & Rune Farming Engine (Req 1, 7, 11)
task.spawn(function()
