                local bValid = States.CurrentBoulder and States.CurrentBoulder.Parent and States.CurrentBoulder:IsDescendantOf(Workspace)
                if not bValid then
                    States.CurrentBoulder = GetNearestBoulder()
                end

                if States.CurrentBoulder then
                    pcall(function()
                        local b = States.CurrentBoulder
                        local targetPart = b:IsA("BasePart") and b or b:FindFirstChildWhichIsA("BasePart", true)
                        if targetPart then
                            myRoot.Velocity = Vector3.new(0, 0, 0)
                            myRoot.RotVelocity = Vector3.new(0, 0, 0)
                            myRoot.CFrame = CFrame.new(targetPart.Position + Vector3.new(0, 2.0, 0))
                        end
                    end)
                end
            end
        end
        task.wait(0.05)
    end
end)

