                                or target:FindFirstChildWhichIsA("ProximityPrompt", true)
                                or (target.Parent and target.Parent:FindFirstChildWhichIsA("ProximityPrompt", true))
                    if prompt then
                        fireproximityprompt(prompt)
                    end
