-- 2. ลูปวาร์ปล็อคตำแหน่งไปหา Rune ชิ้นที่ใกล้ที่สุด
task.spawn(function()
    while true do
        if RuneState.AutoRune then
            local myRoot = GetMyRoot()
            if myRoot then
                local isValid = RuneState.CurrentRune and RuneState.CurrentRune.Parent and RuneState.CurrentRune:IsDescendantOf(Workspace)
                if not isValid then
                    RuneState.CurrentRune = GetNearestRune()
                end

                if RuneState.CurrentRune then
                    pcall(function()
                        local rune = RuneState.CurrentRune
                        local targetPart = rune:IsA("BasePart") and rune or rune:FindFirstChildWhichIsA("BasePart", true)
                        if targetPart then
                            myRoot.Velocity = Vector3.new(0, 0, 0)
                            myRoot.RotVelocity = Vector3.new(0, 0, 0)
                            myRoot.CFrame = CFrame.new(targetPart.Position + Vector3.new(0, 2.0, 0))
                        end
                    end)
                end
            end
        end
        task.wait(0.05)
    end
end)

