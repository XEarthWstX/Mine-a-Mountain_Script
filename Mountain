--// ฟังก์ชันหา Boulder Tier
local function getBoulderTier(boulder)
    local name = boulder.Name:lower()
    local color = nil
    if boulder:IsA("BasePart") then
        color = boulder.Color
    end

    -- ตรวจจากชื่อ
    for tier, keywords in ipairs(CONFIG.TierKeywords) do
        for _, kw in ipairs(keywords) do
            if name:find(kw:lower()) then
                return tier
            end
        end
    end

    -- ตรวจจาก Attribute ถ้ามี
    if boulder:GetAttribute("Tier") then
        return math.clamp(boulder:GetAttribute("Tier"), 1, 6)
    end
    if boulder:GetAttribute("Rarity") then
        return math.clamp(boulder:GetAttribute("Rarity"), 1, 6)
    end

    -- ตรวจจาก BoulderConfig
    if boulderConfig and boulderConfig.Tiers then
        for tierName, tierData in pairs(boulderConfig.Tiers) do
            if name:find(tierName:lower()) then
                return tierData.Level or 1
            end
        end
    end

    return 1 -- Default Common
end

--// ฟังก์ชันหา Targets
local function getDistance(part)
    return (hrp.Position - part.Position).Magnitude
end

local function findBoulders()
    local found = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Parent then
            local isBoulder = false
            for _, keyword in ipairs({"Boulder", "Rock", "Stone", "Ore", "Mineral"}) do
                if obj.Name:match(keyword) then
                    isBoulder = true
                    break
                end
            end
            if isBoulder then
                local isBarrier = false
                pcall(function()
                    if obj:IsDescendantOf(Workspace:FindFirstChild("Barriers")) then
                        isBarrier = true
                    end
                end)
                if not isBarrier and getDistance(obj) <= CONFIG.SearchRadius then
                    local tier = getBoulderTier(obj)
                    if CONFIG.SelectedTiers[tier] then
                        table.insert(found, {Part = obj, Tier = tier, Distance = getDistance(obj)})
                    end
                end
            end
        end
    end
    table.sort(found, function(a, b) return a.Distance < b.Distance end)
    return found
end

local function findRunes()
    local found = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if (obj:IsA("BasePart") or obj:IsA("MeshPart")) and obj.Name:match("Rune$") then
            if obj.Parent and obj.Parent:IsDescendantOf(Workspace) then
                if getDistance(obj) <= CONFIG.SearchRadius then
                    table.insert(found, obj)
                end
            end
        end
    end
    table.sort(found, function(a, b) return getDistance(a) < getDistance(b) end)
    return found
end

--// Tween & Actions
local function tweenToPart(part, offset)
    if not part or not part.Parent then return false end
    local targetPos = part.Position + offset
    local distance = (hrp.Position - targetPos).Magnitude
    if distance < 5 then return true end

    local tweenInfo = TweenInfo.new(
        math.clamp(distance / CONFIG.TeleportSpeed, 0.1, 4),
        Enum.EasingStyle.Linear
    )
    local targetCFrame = CFrame.lookAt(targetPos, part.Position)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    tween:Play()
    tween.Completed:Wait()
    return true
end

local function equipPickaxe()
    local backpack = player:WaitForChild("Backpack")
    for _, toolName in ipairs(CONFIG.PickaxeNames) do
        local tool = backpack:FindFirstChild(toolName)
        if tool and tool:IsA("Tool") then
            humanoid:EquipTool(tool)
            wait(0.2)
            return character:FindFirstChild(toolName)
        end
    end
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") and (tool.Name:lower():match("pick") or tool.Name:lower():match("axe")) then
            humanoid:EquipTool(tool)
            wait(0.2)
            return character:FindFirstChild(tool.Name)
        end
    end
    return nil
end

local function collectRune(runePart)
    if not runePart or not runePart.Parent then return end
    pcall(function()
        firetouchinterest(hrp, runePart, 0)
        wait(0.05)
        firetouchinterest(hrp, runePart, 1)
    end)
    hrp.CFrame = CFrame.new(runePart.Position + Vector3.new(0, 1, 0))
    wait(0.1)
    for _, prompt in ipairs(runePart:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            fireproximityprompt(prompt)
            break
        end
    end
end

local function digBoulder(boulder)
    if CONFIG.AutoEquipPickaxe then
        if not equipPickaxe() then
            warn("ไม่พบ Pickaxe!")
            return
        end
    end

    local tool = character:FindFirstChildOfClass("Tool")
    if not tool then return end

    local attempts = 0
    while boulder and boulder.Parent and attempts < 60 do
        if not _G.AutoFarmEnabled then break end
        hrp.CFrame = CFrame.lookAt(hrp.Position, boulder.Position)
        tool:Activate()
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
        wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
        wait(CONFIG.DigDelay)
        attempts = attempts + 1

        if boulder and boulder.Parent and boulder:IsDescendantOf(Workspace) then
            if (hrp.Position - boulder.Position).Magnitude > 10 then
                tweenToPart(boulder, CONFIG.BoulderOffset)
            end
        else
            break
        end
    end
end

--// Auto Rejoin Function
local function rejoinServer()
    if not CONFIG.AutoRejoin then return end

    statusLabel.Text = "🔄 กำลังรีจอยเซิร์ฟเวอร์..."
    statusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)

    -- บันทึก JobId
    pcall(function()
        if writefile then
            writefile("_boulder_farm_jobid.txt", currentJobId)
            writefile("_boulder_farm_config.txt", HttpService:JSONEncode({
                SelectedTiers = CONFIG.SelectedTiers,
                FarmBoulders = CONFIG.FarmBoulders,
                FarmRunes = CONFIG.FarmRunes
            }))
        end
    end)

    wait(CONFIG.RejoinDelay)

    -- วิธีที่ 1: Teleport กลับเซิร์ฟเดิม (ถ้า API เปิด)
    pcall(function()
        TeleportService:TeleportToPlaceInstance(placeId, currentJobId, player)
    end)

    -- วิธีที่ 2: สำหรับ Executor (queue_on_teleport)
    pcall(function()
        if syn and syn.queue_on_teleport then
            syn.queue_on_teleport([[
                wait(3)
                loadstring(game:HttpGet("https://raw.githubusercontent.com/yourrepo/boulderfarm.lua"))()
            ]])
        elseif queue_on_teleport then
            queue_on_teleport([[
                wait(3)
                -- Auto re-execute script after teleport
            ]])
        end
    end)

    -- วิธีที่ 3: Teleport ธรรมดาแล้วหาเซิร์ฟใหม่ (สำรอง)
    wait(2)
    pcall(function()
        TeleportService:Teleport(placeId, player)
    end)
end

