--// Main Farm Loop
local function farmLoop()
    while _G.AutoFarmEnabled do
        if not character or not hrp or not humanoid or humanoid.Health <= 0 then
            character = player.Character or player.CharacterAdded:Wait()
            hrp = character:WaitForChild("HumanoidRootPart")
            humanoid = character:WaitForChild("Humanoid")
            wait(2)
        end

        local didSomething = false

        -- นับ Boulder
        local allBoulders = findBoulders()
        boulderCount = #allBoulders
        countLabel.Text = "🪨 Boulders: " .. boulderCount .. " | 🔮 Runes: " .. totalRunes

        -- Check rejoin
        if CONFIG.AutoRejoin and boulderCount <= CONFIG.MinBouldersBeforeRejoin then
            statusLabel.Text = "⚠️ Boulder หมด! รีจอยใน " .. CONFIG.RejoinDelay .. " วิ..."
            statusLabel.TextColor3 = Color3.fromRGB(255, 150, 0)
            wait(1)
            rejoinServer()
            return
        end

        -- Farm Runes
        if CONFIG.FarmRunes then
            statusLabel.Text = "🔮 กำลังหา Rune..."
            statusLabel.TextColor3 = Color3.fromRGB(80, 170, 255)
            local runes = findRunes()
            for _, rune in ipairs(runes) do
                if not _G.AutoFarmEnabled then break end
                if rune and rune.Parent and rune:IsDescendantOf(Workspace) then
                    statusLabel.Text = "🔮 เก็บ " .. rune.Name
                    if tweenToPart(rune, CONFIG.RuneOffset) then
                        collectRune(rune)
                        totalRunes = totalRunes + 1
                        didSomething = true
                        wait(CONFIG.RuneCollectDelay)
                    end
                end
            end
        end

        -- Farm Boulders
        if CONFIG.FarmBoulders then
            statusLabel.Text = "🪨 กำลังหา Boulder..."
            statusLabel.TextColor3 = Color3.fromRGB(255, 170, 80)
            for _, data in ipairs(allBoulders) do
                if not _G.AutoFarmEnabled then break end
                local boulder = data.Part
                if boulder and boulder.Parent and boulder:IsDescendantOf(Workspace) then
                    local tierName = CONFIG.TierNames[data.Tier] or "?"
                    statusLabel.Text = "🪨 ขุด " .. boulder.Name .. " [" .. tierName .. "]"
                    statusLabel.TextColor3 = CONFIG.TierColors[data.Tier] or Color3.new(1,1,1)
                    if tweenToPart(boulder, CONFIG.BoulderOffset) then
                        digBoulder(boulder)
                        didSomething = true
                        wait(0.2)
                    end
                end
            end
        end

        if not didSomething then
            statusLabel.Text = "⏳ รอ Target..."
            statusLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
            wait(2)
        end

        RunService.Heartbeat:Wait()
    end

    statusLabel.Text = "⏹️ สถานะ: ปิดอยู่"
    statusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
    isFarming = false
end

--// Toggle
local function toggleFarm()
    _G.AutoFarmEnabled = not _G.AutoFarmEnabled
    if _G.AutoFarmEnabled then
        if not isFarming then
            isFarming = true
            sessionStart = tick()
            statusLabel.Text = "▶️ สถานะ: เริ่มทำงาน..."
            statusLabel.TextColor3 = Color3.fromRGB(80, 255, 120)
            if CONFIG.NotifyOnRejoin then
                sendDiscord("🟢 **เริ่มฟาร์ม** บนเซิร์ฟเวอร์", 0x00FF00)
            end
            spawn(farmLoop)
        end
    else
        statusLabel.Text = "⏹️ กำลังปิด..."
        saveData()
    end
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == CONFIG.ToggleKey then
        toggleFarm()
    end
end)

