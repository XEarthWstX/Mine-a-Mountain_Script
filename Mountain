-- หาตำแหน่งตัวละครของเรา
local function GetMyRoot()
    local char = LP.Character
    return char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChildWhichIsA("BasePart"))
end

-- ค้นหา Rune ชิ้นที่อยู่ใกล้เราที่สุด
local function GetNearestRune()
    if not RunesFolder then return nil end
    local myRoot = GetMyRoot()
    if not myRoot then return nil end

    local closestRune = nil
    local shortestDistance = math.huge

    for _, rune in ipairs(RunesFolder:GetChildren()) do
        if rune and rune.Parent then
            local targetPart = rune:IsA("BasePart") and rune or rune:FindFirstChildWhichIsA("BasePart", true)
            if targetPart then
                local dist = (myRoot.Position - targetPart.Position).Magnitude
                if dist < shortestDistance then
                    shortestDistance = dist
                    closestRune = rune
                end
            end
        end
    end
    return closestRune
end

-- ฟังก์ชั่นวาร์ปไปหา Rune ชิ้นที่ใกล้ที่สุด 1 ครั้ง
local function TeleportToNearestRune()
    local nearestRune = GetNearestRune()
    local myRoot = GetMyRoot()
    if nearestRune and myRoot then
        local targetPart = nearestRune:IsA("BasePart") and nearestRune or nearestRune:FindFirstChildWhichIsA("BasePart", true)
        if targetPart then
            myRoot.CFrame = CFrame.new(targetPart.Position + Vector3.new(0, 2, 0))
            return true
        end
    end
    return false
end

