local function GetRoot(player)
    local p = player or LP
    local char = p.Character
    return char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChildWhichIsA("BasePart"))
end

local function GetHumanoid(player)
    local p = player or LP
    local char = p.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function GetOtherPlayers()
    local names = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then table.insert(names, p.Name) end
    end
    if #names == 0 then table.insert(names, "None") end
    return names
end

local function GetCrystalWeight(crystal)
    if not crystal then return 0 end
    local weightAttr = crystal:GetAttribute("Weight") or crystal:GetAttribute("CrystalWeight") or crystal:GetAttribute("ItemWeight")
    if weightAttr and type(weightAttr) == "number" then return weightAttr end

    local weightObj = crystal:FindFirstChild("Weight") or crystal:FindFirstChild("WeightValue")
    if weightObj and weightObj:IsA("ValueBase") then return weightObj.Value end

    local name = crystal.Name
    local weightInName = name:match("(%d+%.?%d*)%s*kg") or name:match("Weight:%s*(%d+%.?%d*)") or name:match("(%d+%.?%d*)")
    if weightInName then return tonumber(weightInName) or 0 end
    return 0
end

local function IsRune(instance)
    if not instance then return false end
    local name = string.lower(instance.Name)
    if name:find("rune") then return true end
    local typeAttr = instance:GetAttribute("Type") or instance:GetAttribute("ItemType")
    if typeAttr and string.lower(tostring(typeAttr)):find("rune") then return true end
    return false
end

local function IsBoulder(instance)
    if not instance then return false end
    local name = string.lower(instance.Name)
    if name:find("boulder") then return true end
    local typeAttr = instance:GetAttribute("Type") or instance:GetAttribute("ItemType")
    if typeAttr and string.lower(tostring(typeAttr)):find("boulder") then return true end
    return false
end

local function SatisfiesWeightFilter(crystal)
    if not States.WeightFilterEnabled then return true end
    local weight = GetCrystalWeight(crystal)
    return weight <= States.MaxAllowedWeight
end

local function GetNearestCrystal(filterRuneOnly)
    if not CrystalsFolder then return nil end
    local myRoot = GetRoot()
    if not myRoot then return nil end

    local closest = nil
    local shortestDistance = math.huge

    for _, crystal in ipairs(CrystalsFolder:GetChildren()) do
        if crystal and crystal.Parent and not PermanentBlacklist[crystal] then
            local isRuneMatch = filterRuneOnly and IsRune(crystal) or not filterRuneOnly
            local isWeightOk = SatisfiesWeightFilter(crystal)

            if isRuneMatch and isWeightOk then
                local targetPart = crystal:IsA("BasePart") and crystal or crystal:FindFirstChildWhichIsA("BasePart", true)
                if targetPart then
                    local dist = (myRoot.Position - targetPart.Position).Magnitude
                    if dist < shortestDistance then
                        shortestDistance = dist
                        closest = crystal
                    end
                end
            end
        end
    end
    return closest
end

-- Boulder Finder
local function GetNearestBoulder()
    local myRoot = GetRoot()
    if not myRoot then return nil end

    local closest = nil
    local shortestDistance = math.huge

    local searchFolders = {BouldersFolder, CrystalsFolder, ThingsFolder, Workspace}
    for _, folder in ipairs(searchFolders) do
        if folder then
            for _, item in ipairs(folder:GetChildren()) do
                if item and item.Parent and IsBoulder(item) and not PermanentBlacklist[item] then
                    local targetPart = item:IsA("BasePart") and item or item:FindFirstChildWhichIsA("BasePart", true)
                    if targetPart then
                        local dist = (myRoot.Position - targetPart.Position).Magnitude
                        if dist < shortestDistance then
                            shortestDistance = dist
                            closest = item
                        end
                    end
                end
            end
        end
    end
    return closest
end

local function CheckInventoryStatus()
    local currentWeight = 0
    local maxWeight = States.InventoryMaxCapacity

    local weightAttr = LP:GetAttribute("Weight") or LP:GetAttribute("CurrentWeight") or LP:GetAttribute("InventoryWeight")
    local maxAttr = LP:GetAttribute("MaxWeight") or LP:GetAttribute("MaxCapacity") or LP:GetAttribute("Capacity")

    if weightAttr then currentWeight = tonumber(weightAttr) or currentWeight end
    if maxAttr then maxWeight = tonumber(maxAttr) or maxWeight end

    local ls = LP:FindFirstChild("leaderstats")
    if ls then
        local wVal = ls:FindFirstChild("Weight") or ls:FindFirstChild("Inventory")
        local mVal = ls:FindFirstChild("MaxWeight") or ls:FindFirstChild("Capacity")
        if wVal then currentWeight = wVal.Value end
        if mVal then maxWeight = mVal.Value end
    end

    if currentWeight == 0 and LP:FindFirstChild("Backpack") then
        currentWeight = #LP.Backpack:GetChildren()
    end

    States.CurrentInventoryWeight = currentWeight
    States.InventoryMaxCapacity = maxWeight
    return currentWeight, maxWeight
end

local function DropAllOresExceptRunes()
    local backpack = LP:FindFirstChild("Backpack")
    local char = LP.Character

    local function processItem(item)
        if item:IsA("Tool") and not IsRune(item) then
            if DropRequest then
                pcall(function() DropRequest:FireServer(item) end)
            else
                pcall(function()
                    item.Parent = Workspace
                    if GetRoot() then
                        local handle = item:FindFirstChild("Handle") or item:FindFirstChildWhichIsA("BasePart")
                        if handle then handle.CFrame = GetRoot().CFrame * CFrame.new(0, 0, -3) end
                    end
                end)
            end
        end
    end

    if backpack then for _, item in ipairs(backpack:GetChildren()) do processItem(item) end end
    if char then for _, item in ipairs(char:GetChildren()) do processItem(item) end end
end

