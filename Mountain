local function log(msg, color)
    if Config.UseConsole and rconsoleprint then
        if color then
            rconsoleprint("[" .. msg .. "]\n")
        else
            rconsoleprint(msg .. "\n")
        end
    else
        print(msg)
    end
end

local function getProperties(instance)
    local className = instance.ClassName
    local props = CLASS_PROPERTIES[className] or {"Name", "ClassName"}
    local data = {
        Name      = instance.Name,
        ClassName = className
    }
    
    for _, propName in ipairs(props) do
        local success, value = pcall(function() return instance[propName] end)
        if success then
            local valType = typeof(value)
            if valType == "Instance" then
                data[propName] = value:GetFullName()
            elseif valType == "Color3" then
                data[propName] = {R = value.R, G = value.G, B = value.B, _type = "Color3"}
            elseif valType == "Vector3" then
                data[propName] = {X = value.X, Y = value.Y, Z = value.Z, _type = "Vector3"}
            elseif valType == "Vector2" then
                data[propName] = {X = value.X, Y = value.Y, _type = "Vector2"}
            elseif valType == "CFrame" then
                local pos = value.Position
                local rot = {value:ToEulerAnglesXYZ()}
                data[propName] = {X = pos.X, Y = pos.Y, Z = pos.Z, RX = rot[1], RY = rot[2], RZ = rot[3], _type = "CFrame"}
            elseif valType == "UDim2" then
                data[propName] = {ScaleX = value.X.Scale, OffsetX = value.X.Offset, ScaleY = value.Y.Scale, OffsetY = value.Y.Offset, _type = "UDim2"}
            elseif valType == "EnumItem" or valType == "BrickColor" then
                data[propName] = tostring(value)
            elseif valType == "NumberRange" then
                data[propName] = {Min = value.Min, Max = value.Max, _type = "NumberRange"}
            else
                data[propName] = value
            end
        end
    end
    
    if Config.SaveAttributes then
        local attrs = instance:GetAttributes()
        if next(attrs) ~= nil then data._attributes = attrs end
    end
    
    return data
end

-- ============================================
-- SECTION 3: CORE - dumpInstance
-- ============================================
local function dumpInstance(instance, depth)
    depth = depth or 0
    if depth > Config.MaxDepth then
        return { Name = instance.Name, ClassName = instance.ClassName, _truncated = true, _reason = "MaxDepth: " .. Config.MaxDepth }
    end
    
    local data = getProperties(instance)
    local children = instance:GetChildren()
    
    if #children > 0 then
        data._children = {}
        for _, child in ipairs(children) do
            if not Config.IncludeRobloxLocked then
                local ok, isLocked = pcall(function() return child.RobloxLocked end)
                if ok and isLocked then continue end
            end
            table.insert(data._children, dumpInstance(child, depth + 1))
        end
    end
    
    return data
end

-- ============================================
-- SECTION 4: EXPORT
-- ============================================
local LastJSON = ""

local function toJSON(data, pretty)
    pretty = pretty ~= false
    local success, result = pcall(function() return HttpService:JSONEncode(data) end)
    if success then
        if pretty then
            result = result:gsub("([%{%}%[%]%,])", "%1\n"):gsub("\":", "\": "):gsub("\n\n+", "\n")
        end
        return result
    else
        log("❌ JSON Encode failed: " .. tostring(result))
        return nil
    end
end

local function saveToFile(data, filename)
    filename = filename or ("Dump_" .. os.time() .. ".json")
    if not string.match(filename, "%.json$") then filename = filename .. ".json" end
    
    local filepath = Config.OutputFolder .. filename
    local json = toJSON(data, false)
    if not json then return false end
    
    LastJSON = json
    writefile(filepath, json)
    log("✅ Saved: " .. filepath .. " (" .. tostring(#json) .. " chars)")
    return true
end

local function copyLastJSON()
    if LastJSON ~= "" and setclipboard then
        setclipboard(LastJSON)
        log("📋 Copied to clipboard!")
        return true
    else
        log("⚠️ Nothing to copy")
        return false
    end
end

local function listDumps()
    if not listfiles then log("❌ listfiles not supported") return {} end
    local files = listfiles(Config.OutputFolder)
    log("📁 Files in " .. Config.OutputFolder .. ":")
    for _, f in ipairs(files) do log("   • " .. f) end
    return files
end

