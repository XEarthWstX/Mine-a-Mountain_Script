-- Player Chams
local function CreatePlayerESP(player)
    if player == LP or Player_ESP_Cache[player] then return end
    local container = {}

    local function applyESP(char)
        if not char then return end
        if container.Highlight then pcall(function() container.Highlight:Destroy() end) end

        local hl = Instance.new("Highlight")
        hl.Name = "DaleyKavo_PlayerHighlight"
        hl.FillColor = Color3.fromRGB(0, 255, 150)
        hl.FillTransparency = 0.5
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.Adornee = char
        hl.Enabled = States.PlayerESP
        hl.Parent = char
        container.Highlight = hl
    end

    if player.Character then applyESP(player.Character) end
    player.CharacterAdded:Connect(applyESP)
    Player_ESP_Cache[player] = container
end

local function RemovePlayerESP(player)
    if Player_ESP_Cache[player] then
        pcall(function()
            if Player_ESP_Cache[player].Highlight then Player_ESP_Cache[player].Highlight:Destroy() end
        end)
        Player_ESP_Cache[player] = nil
    end
end

-- Crystal & Rune Chams (Req 7)
local function CreateCrystalESP(crystal)
    if Crystal_ESP_Cache[crystal] then return end
    
    local isRuneItem = IsRune(crystal)
    local hl = Instance.new("Highlight")
    hl.Name = isRuneItem and "DaleyKavo_RuneHighlight" or "DaleyKavo_CrystalHighlight"
    hl.FillColor = isRuneItem and Color3.fromRGB(255, 215, 0) or Color3.fromRGB(190, 0, 255)
    hl.FillTransparency = 0.3
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.Adornee = crystal
    hl.Enabled = isRuneItem and (States.CrystalESP or States.RuneESP) or States.CrystalESP
    hl.Parent = crystal
    
    Crystal_ESP_Cache[crystal] = hl
end

local function RemoveCrystalESP(crystal)
    if Crystal_ESP_Cache[crystal] then
        pcall(function()
            Crystal_ESP_Cache[crystal]:Destroy()
        end)
        Crystal_ESP_Cache[crystal] = nil
    end
end

-- Initialize ESP Loops
