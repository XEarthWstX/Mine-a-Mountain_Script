-- Bind ESP to Folders
local function BindFolderESP(folderGetter, createFunc, removeFunc)
    task.spawn(function()
        while true do
            local folder = folderGetter()
            if folder then
                for _, child in ipairs(folder:GetChildren()) do createFunc(child) end
                folder.ChildAdded:Connect(createFunc)
                folder.ChildRemoved:Connect(removeFunc)
                break
            end
            task.wait(1)
        end
    end)
end

