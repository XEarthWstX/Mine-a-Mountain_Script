end)

-- Crystal Sequential Target Tracking Loop
task.spawn(function()
    while true do
        if States.AutoCrystal then
            local myRoot = GetRoot()
            if myRoot then
                local now = os.clock()
                
                local targetValid = States.CurrentCrystal and States.CurrentCrystal.Parent and States.CurrentCrystal:IsDescendantOf(Workspace)
                
                local forcedSkip = States.SkipCurrent
                if forcedSkip then
                    States.SkipCurrent = false
                end

                local timeIsUp = false
                if States.CrystalHoldTime > 0 then
                    timeIsUp = (now - States.LockTimestamp) >= States.CrystalHoldTime
                end
                
                if targetValid and States.CrystalHoldTime > 0 and (now - CrystalTargetStartTime > States.CrystalHoldTime + 10) then
                    PermanentBlacklist[States.CurrentCrystal] = true
                    States.CurrentCrystal = nil
                    targetValid = false
                end

                if not targetValid and not forcedSkip then
                    States.CurrentCrystal = nil
                    local newTarget = GetNearestCrystal()
                    if newTarget then
                        States.CurrentCrystal = newTarget
                        CrystalTargetStartTime = now
                        States.LockTimestamp = now
                    end
                elseif timeIsUp or forcedSkip then
                    local oldCrystal = States.CurrentCrystal
                    States.CurrentCrystal = nil
                    
                    local closest = nil
                    local shortestDistance = math.huge
                    
                    if CrystalsFolder then
                        for _, crystal in ipairs(CrystalsFolder:GetChildren()) do
                            if crystal and crystal.Parent and crystal ~= oldCrystal and not PermanentBlacklist[crystal] then
                                local targetPart = crystal:IsA("BasePart") and crystal or crystal:FindFirstChildWhichIsA("BasePart", true)
                                if targetPart then
                                    local dist = (myRoot.Position - targetPart.Position).Magnitude
                                    if dist < shortestDistance then
                                        shortestDistance = dist
                                        closest = crystal
                                   end
                                end
                            end
                        end
                    end
                    
                    if closest then
                        States.CurrentCrystal = closest
                        CrystalTargetStartTime = now
                        States.LockTimestamp = now
                    else
                        States.CurrentCrystal = oldCrystal
                        States.LockTimestamp = now 
                    end
                end

                if States.CurrentCrystal then
                    pcall(function()
                        local crystal = States.CurrentCrystal
                        local targetPart = crystal:IsA("BasePart") and crystal or crystal:FindFirstChildWhichIsA("BasePart", true)
                        if targetPart then
                            myRoot.Velocity = Vector3.new(0, 0, 0)
                            myRoot.RotVelocity = Vector3.new(0, 0, 0)
                            myRoot.CFrame = CFrame.new(targetPart.Position + Vector3.new(0, 1.5, 0))
                        end
                    end)
                end
            end
        end
        task.wait(0.01)
    end
end)

