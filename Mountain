-- Helper Function to Create UI Items
local function createFunctionRow(labelText, actionType, callback)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, -10, 0, 42)
	row.BackgroundColor3 = Color3.fromRGB(30, 33, 42)
	row.Parent = container
	
	local rowCorner = Instance.new("UICorner")
	rowCorner.CornerRadius = UDim.new(0, 8)
	rowCorner.Parent = row
	
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0.65, -10, 1, 0)
	label.Position = UDim2.new(0, 12, 0, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamMedium
	label.TextSize = 13
	label.TextColor3 = Color3.fromRGB(220, 225, 235)
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Text = labelText
	label.Parent = row
	
	if actionType == "Button" then
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(0.3, 0, 0, 28)
		btn.Position = UDim2.new(0.68, 0, 0.5, -14)
		btn.BackgroundColor3 = Color3.fromRGB(0, 180, 216)
		btn.Font = Enum.Font.GothamBold
		btn.TextSize = 12
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		btn.Text = Locales[currentLang].Execute
		btn.Parent = row
		
		local btnC = Instance.new("UICorner")
		btnC.CornerRadius = UDim.new(0, 6)
		btnC.Parent = btn
		
		btn.MouseButton1Click:Connect(function()
			callback()
		end)
	elseif actionType == "Toggle" then
		local toggled = false
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(0.3, 0, 0, 28)
		btn.Position = UDim2.new(0.68, 0, 0.5, -14)
		btn.BackgroundColor3 = Color3.fromRGB(50, 55, 65)
		btn.Font = Enum.Font.GothamBold
		btn.TextSize = 12
		btn.TextColor3 = Color3.fromRGB(200, 200, 200)
		btn.Text = Locales[currentLang].ToggleOff
		btn.Parent = row
		
		local btnC = Instance.new("UICorner")
		btnC.CornerRadius = UDim.new(0, 6)
		btnC.Parent = btn
		
		btn.MouseButton1Click:Connect(function()
			toggled = not toggled
			if toggled then
				tween(btn, {0.2}, {BackgroundColor3 = Color3.fromRGB(0, 201, 167), TextColor3 = Color3.fromRGB(255, 255, 255)})
				btn.Text = Locales[currentLang].ToggleOn
			else
				tween(btn, {0.2}, {BackgroundColor3 = Color3.fromRGB(50, 55, 65), TextColor3 = Color3.fromRGB(200, 200, 200)})
				btn.Text = Locales[currentLang].ToggleOff
			end
			callback(toggled)
		end)
	elseif actionType == "Input" then
		local box = Instance.new("TextBox")
		box.Size = UDim2.new(0.3, 0, 0, 28)
		box.Position = UDim2.new(0.68, 0, 0.5, -14)
		box.BackgroundColor3 = Color3.fromRGB(40, 44, 55)
		box.Font = Enum.Font.Gotham
		box.TextSize = 13
		box.TextColor3 = Color3.fromRGB(255, 255, 255)
		box.PlaceholderText = "Val"
		box.Text = ""
		box.Parent = row
		
		local boxC = Instance.new("UICorner")
		boxC.CornerRadius = UDim.new(0, 6)
		boxC.Parent = box
		
		box.FocusLost:Connect(function(enterPressed)
			if enterPressed then
				local num = tonumber(box.Text)
				if num then
					callback(num)
				end
			end
		end)
	end
	return row
end

-- Refresh Language Function
local function applyLanguage(langKey)
	currentLang = langKey
	local l = Locales[langKey]
	
	hubTitleLabel.Text = l.HubTitle
	
	-- Clear Container
	for _, child in ipairs(container:GetChildren()) do
		if not child:IsA("UIListLayout") then
			child:Destroy()
		end
	end
	
	-- Populate Functions based on selected language
	-- 1. WalkSpeed
	createFunctionRow(l.WalkSpeedLabel, "Input", function(val)
		if player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
			player.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = val
		end
	end)
	
	-- 2. JumpPower
	createFunctionRow(l.JumpPowerLabel, "Input", function(val)
		if player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
			local hum = player.Character:FindFirstChildOfClass("Humanoid")
			hum.UseJumpPower = true
			hum.JumpPower = val
		end
	end)
	
	-- 3. FOV Adjuster
	createFunctionRow(l.FovLabel, "Input", function(val)
		Workspace.CurrentCamera.FieldOfView = math.clamp(val, 30, 120)
	end)
	
	-- 4. Night Vision Toggle
	createFunctionRow(l.NightVisionLabel, "Toggle", function(state)
		if state then
			Lighting.Ambient = Color3.fromRGB(255, 255, 255)
			Lighting.Brightness = 3
		else
			Lighting.Ambient = Color3.fromRGB(128, 128, 128)
			Lighting.Brightness = 1
		end
	end)
	
	-- 5. Teleport Spawn
	createFunctionRow(l.TpSpawnLabel, "Button", function()
		if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
			local spawnLocation = Workspace:FindFirstChildOfClass("SpawnLocation")
			if spawnLocation then
				player.Character.HumanoidRootPart.CFrame = spawnLocation.CFrame + Vector3.new(0, 5, 0)
			else
				player.Character.HumanoidRootPart.CFrame = CFrame.new(0, 50, 0)
			end
		end
	end)
	
	-- 6. Reset Character
	createFunctionRow(l.ResetCharLabel, "Button", function()
		if player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
			player.Character:FindFirstChildOfClass("Humanoid").Health = 0
		end
	end)
end

