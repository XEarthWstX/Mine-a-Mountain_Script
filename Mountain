local SG = game:GetService("StarterGui")

-- ฟังก์ชันแสดงป๊อปอัพบนหน้าจอ
local function notify(title, text)
    pcall(function()
        SG:SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = 5
        })
    end)
end

-- แจ้งเตือนทันทีเมื่อเริ่มรัน
notify("Dumper Status", "⏳ กำลังเริ่ม Dump ReplicatedStorage...")

task.spawn(function()
    local success, err = pcall(function()
        local HttpService = game:GetService("HttpService")
        local RS = game:GetService("ReplicatedStorage")

        local function dump(inst)
            local data = {Name = inst.Name, ClassName = inst.ClassName}
            pcall(function() if inst.Value ~= nil then data.Value = inst.Value end end)
            if typeof(decompile) == "function" and inst:IsA("LuaSourceContainer") then
                pcall(function() data.Source = decompile(inst) end)
            end
            local children = inst:GetChildren()
            if #children > 0 then
                data._children = {}
                for _, child in ipairs(children) do
                    table.insert(data._children, dump(child))
                end
            end
            return data
        end

        local data = dump(RS)
        local json = HttpService:JSONEncode(data)
        
        if typeof(setclipboard) == "function" then setclipboard(json) end
        if typeof(writefile) == "function" then writefile("RS_Dump.json", json) end
        
        notify("✅ Dump สำเร็จ!", "ก๊อปปี้ลง Clipboard & เซฟไฟล์เรียบร้อย! (" .. #json .. " ตัวอักษร)")
    end)

    if not success then
        notify("❌ เกิดข้อผิดพลาด!", tostring(err))
    end
end)
