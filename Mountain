                if target then
                    local prompt = target:FindFirstChildOfClass("ProximityPrompt") or target:FindFirstChildWhichIsA("ProximityPrompt", true)
                    if prompt then fireproximityprompt(prompt) end
                end

                if States.AutoCollectOres and myRoot then
                    local searchFolders = {DropsFolder, Workspace:FindFirstChild("Drops"), Workspace:FindFirstChild("Items")}
                    for _, folder in ipairs(searchFolders) do
                        if folder then
                            for _, drop in ipairs(folder:GetChildren()) do
                                local part = drop:IsA("BasePart") and drop or drop:FindFirstChildWhichIsA("BasePart", true)
                                if part and (myRoot.Position - part.Position).Magnitude <= States.AutoCollectRadius then
                                    local prompt = drop:FindFirstChildOfClass("ProximityPrompt") or drop:FindFirstChildWhichIsA("ProximityPrompt", true)
                                    if prompt then fireproximityprompt(prompt) end
                                end
                            end
                        end
                    end
                end
            end)
        end
        task.wait(0.1)
    end
end)

-- Auto Mine & Tracking Daemon (Crystals, Boulders, Runes)
task.spawn(function()
    while true do
        if States.AutoCrystal or States.AutoRuneFarm or States.AutoBoulderFarm then
            local myRoot = GetRoot()
            if myRoot then
                local now = os.clock()
                local isRune = States.AutoRuneFarm
                local isBoulder = States.AutoBoulderFarm

                local activeTarget = isRune and States.CurrentRune or (isBoulder and States.CurrentBoulder or States.CurrentCrystal)
                local targetValid = activeTarget and activeTarget.Parent and activeTarget:IsDescendantOf(Workspace)

                if not targetValid then
                    if isRune then
                        States.CurrentRune = GetNearestCrystal(true)
                    elseif isBoulder then
                        States.CurrentBoulder = GetNearestBoulder()
                    else
                        States.CurrentCrystal = GetNearestCrystal(false)
                    end
                end

                local currentTarget = isRune and States.CurrentRune or (isBoulder and States.CurrentBoulder or States.CurrentCrystal)
                if currentTarget then
                    pcall(function()
                        local p = currentTarget:IsA("BasePart") and currentTarget or currentTarget:FindFirstChildWhichIsA("BasePart", true)
                        if p then
                            myRoot.Velocity = Vector3.new(0, 0, 0)
                            myRoot.CFrame = CFrame.new(p.Position + Vector3.new(0, 1.5, 0))
                        end
                    end)
                end
            end
        end
        task.wait(0.01)
    end
end)

