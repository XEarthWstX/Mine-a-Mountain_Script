        if States.AutoCrystal or States.AutoRuneFarm then
            local myRoot = GetRoot()
            if myRoot then
                local now = os.clock()
                local isRuneMode = States.AutoRuneFarm
                
                -- Verify if target still exists in workspace
                local activeTarget = isRuneMode and States.CurrentRune or States.CurrentCrystal
                local targetValid = activeTarget and activeTarget.Parent and activeTarget:IsDescendantOf(Workspace)
                
                -- Evaluate active button trigger bypass
                local forcedSkip = States.SkipCurrent
                if forcedSkip then States.SkipCurrent = false end

                -- Condition: If hold timer is set to 0, completely bypass timeIsUp triggers
                local timeIsUp = false
                if States.CrystalHoldTime > 0 then
                    timeIsUp = (now - States.LockTimestamp) >= States.CrystalHoldTime
                end
                
                -- Anti-Stuck Timeout: Only evaluate if an active timer limit exists
                if targetValid and States.CrystalHoldTime > 0 and (now - CrystalTargetStartTime > States.CrystalHoldTime + 10) then
                    PermanentBlacklist[activeTarget] = true
                    if isRuneMode then States.CurrentRune = nil else States.CurrentCrystal = nil end
                    targetValid = false
                end

                -- State Progression & Bypassing Engine
                if not targetValid and not forcedSkip then
                    if isRuneMode then States.CurrentRune = nil else States.CurrentCrystal = nil end
                    local newTarget = GetNearestCrystal(isRuneMode)
                    if newTarget then
                        if isRuneMode then States.CurrentRune = newTarget else States.CurrentCrystal = newTarget end
                        CrystalTargetStartTime = now
                        States.LockTimestamp = now
                    end
                elseif timeIsUp or forcedSkip then
                    -- Rotation strategy handler
                    local oldTarget = isRuneMode and States.CurrentRune or States.CurrentCrystal
                    if isRuneMode then States.CurrentRune = nil else States.CurrentCrystal = nil end
                    
                    local closest = nil
                    local shortestDistance = math.huge
                    
                    if CrystalsFolder then
                        for _, crystal in ipairs(CrystalsFolder:GetChildren()) do
                            local isRuneMatch = isRuneMode and IsRune(crystal) or not isRuneMode
                            local isWeightOk = SatisfiesWeightFilter(crystal)

                            if crystal and crystal.Parent and crystal ~= oldTarget and not PermanentBlacklist[crystal] and isRuneMatch and isWeightOk then
                                local targetPart = crystal:IsA("BasePart") and crystal or crystal:FindFirstChildWhichIsA("BasePart", true)
                                if targetPart then
                                    local dist = (myRoot.Position - targetPart.Position).Magnitude
                                    if dist < shortestDistance then
                                        shortestDistance = dist
                                        closest = crystal
                                   end
                                end
                            end
                        end
                    end
                    
                    -- Process evaluation fallback patterns
                    if closest then
                        if isRuneMode then States.CurrentRune = closest else States.CurrentCrystal = closest end
                        CrystalTargetStartTime = now
                        States.LockTimestamp = now
                    else
                        if isRuneMode then States.CurrentRune = oldTarget else States.CurrentCrystal = oldTarget end
                        States.LockTimestamp = now 
                    end
                end

                -- Action Phase: Physical CFrame Anchor Lock
                local currentTarget = isRuneMode and States.CurrentRune or States.CurrentCrystal
                if currentTarget then
                    pcall(function()
                        local targetPart = currentTarget:IsA("BasePart") and currentTarget or currentTarget:FindFirstChildWhichIsA("BasePart", true)
                        if targetPart then
                            myRoot.Velocity = Vector3.new(0, 0, 0)
                            myRoot.RotVelocity = Vector3.new(0, 0, 0)
                            myRoot.CFrame = CFrame.new(targetPart.Position + Vector3.new(0, 1.5, 0))
                        end
                    end)
                end
            end
        end
        task.wait(0.01)
    end
end)

