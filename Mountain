-- 3. MINIMIZE / EXPAND LOGIC (ระบบย่อและขยายหน้าต่าง)
-- -------------------------------------------------------------
local expandedSize = UDim2.new(0, 440, 0, 340)
local minimizedSize = UDim2.new(0, 440, 0, 42) -- เหลือเฉพาะความสูง Topbar
local isMinimized = false

local function toggleMinimize()
	isMinimized = not isMinimized
	
	if isMinimized then
		-- ซ่อนเนื้อหาก่อน แล้วย่อขนาดกล่องหลักลงมา
		contentFrame.Visible = false
		tween(mainFrame, 0.3, {Size = minimizedSize}, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		minimizeBtn.Text = "+"
		tween(minimizeBtn, 0.2, {BackgroundColor3 = Color3.fromRGB(0, 201, 167)})
	else
		-- ขยายกล่องหลักขึ้นก่อน แล้วแสดงเนื้อหาเมื่อขยายเสร็จ
		minimizeBtn.Text = "-"
		tween(minimizeBtn, 0.2, {BackgroundColor3 = Color3.fromRGB(45, 50, 62)})
		
		local t = tween(mainFrame, 0.3, {Size = expandedSize}, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		t.Completed:Connect(function()
			if not isMinimized then
				contentFrame.Visible = true
			end
		end)
	end
end

minimizeBtn.MouseButton1Click:Connect(toggleMinimize)

closeBtn.MouseButton1Click:Connect(function()
	-- เมื่อกดปิด ให้ซ่อนหน้าต่างหลัก แล้วแสดงหน้าเลือกภาษา
	mainFrame.Visible = false
	langFrame.Visible = true
end)

