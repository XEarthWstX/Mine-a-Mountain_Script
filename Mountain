local function CreateSlider(parentTab, labelKey, minVal, maxVal, defaultVal, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -8, 0, 48)
    frame.BackgroundColor3 = Color3.fromRGB(28, 32, 48)
    frame.BorderSizePixel = 0
    frame.Parent = parentTab

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = frame

    local txt = Instance.new("TextLabel")
    txt.Position = UDim2.new(0, 12, 0, 4)
    txt.Size = UDim2.new(0.7, 0, 0, 20)
    txt.BackgroundTransparency = 1
    txt.Font = Enum.Font.GothamSemibold
    txt.Text = Text(labelKey) .. ": " .. tostring(defaultVal)
    txt.TextColor3 = Color3.fromRGB(210, 215, 235)
    txt.TextSize = 12
    txt.TextXAlignment = Enum.TextXAlignment.Left
    txt.Parent = frame

    table.insert(ElementLabels, {LabelObj = txt, Key = labelKey, IsSlider = true, Min = minVal, Max = maxVal, Val = defaultVal})

    local sliderBg = Instance.new("Frame")
    sliderBg.Position = UDim2.new(0, 12, 0, 28)
    sliderBg.Size = UDim2.new(1, -24, 0, 10)
    sliderBg.BackgroundColor3 = Color3.fromRGB(45, 50, 70)
    sliderBg.BorderSizePixel = 0
    sliderBg.Parent = frame

    local bgCorner = Instance.new("UICorner")
    bgCorner.CornerRadius = UDim.new(0, 5)
    bgCorner.Parent = sliderBg

    local fill = Instance.new("Frame")
    local initRatio = (defaultVal - minVal) / (maxVal - minVal)
    fill.Size = UDim2.new(initRatio, 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(0, 170, 240)
    fill.BorderSizePixel = 0
    fill.Parent = sliderBg

    local fillCorner = Instance.new("UICorner")
    fillCorner.CornerRadius = UDim.new(0, 5)
    fillCorner.Parent = fill

    local sliding = false
    sliderBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            sliding = true
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            sliding = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local mousePos = input.Position.X
            local bgPos = sliderBg.AbsolutePosition.X
            local bgWidth = sliderBg.AbsoluteSize.X
            local rel = math.clamp((mousePos - bgPos) / bgWidth, 0, 1)
            fill.Size = UDim2.new(rel, 0, 1, 0)
            local val = math.floor(minVal + (maxVal - minVal) * rel)
            txt.Text = Text(labelKey) .. ": " .. tostring(val)
            if callback then callback(val) end
        end
    end)
    return frame
end

