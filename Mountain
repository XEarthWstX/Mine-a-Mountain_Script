-- ลูปสแกนสร้าง ESP สำหรับ Boulders / Nocturnite
task.spawn(function()
    while true do
        local folder = GetBouldersFolder()
        if folder then
            local function registerItem(item)
                CreateBoulderESP(item)
                if item:IsA("Model") or item:IsA("Folder") then
                    for _, cell in ipairs(item:GetChildren()) do
                        CreateBoulderESP(cell)
                    end
                    item.ChildAdded:Connect(CreateBoulderESP)
                end
            end

            for _, child in ipairs(folder:GetChildren()) do
                registerItem(child)
            end
            folder.ChildAdded:Connect(registerItem)
            break
        end
        task.wait(2)
    end
end)

